# Stack identity
STACK_NAME=webowie
DEPLOY_ENV=staging
DEPLOY_EPOCH=0

# Public endpoints
OPS_HOST=ops.example.com
GRAFANA_HOST=grafana.example.com
GRAFANA_ADMIN_USER=admin
ACME_EMAIL=admin@example.com

# Own CI artifact
WEBOWIE_OPS_IMAGE=ghcr.io/webowie/webowie-ops
IMAGE_TAG=dev
GIT_SHA=local

# Pin these to tested tags/digests before production rollout.
SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:latest
TRAEFIK_IMAGE=traefik:v3
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:latest
NODE_EXPORTER_IMAGE=quay.io/prometheus/node-exporter:latest

# Never store the Grafana password in this file.
# Export GRAFANA_ADMIN_PASSWORD in the deployment environment or provision
# the external Swarm secret 'grafana_admin_password' beforehand.
