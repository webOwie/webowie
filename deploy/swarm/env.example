# Stack identity
STACK_NAME=webowie
DEPLOY_ENV=staging
DEPLOY_EPOCH=0

# Public endpoints
OPS_HOST=ops.example.com
GRAFANA_HOST=grafana.example.com
GRAFANA_ADMIN_USER=admin
ACME_EMAIL=admin@example.com

# Own CI artifact
WEBOWIE_OPS_IMAGE=ghcr.io/webowie/webowie-ops
IMAGE_TAG=dev
GIT_SHA=local

# Tested release baseline. Prefer digest pinning after the first successful production pull.
SOCKET_PROXY_IMAGE=ghcr.io/tecnativa/docker-socket-proxy:v0.5.0
TRAEFIK_IMAGE=traefik:v3.7.1
PROMETHEUS_IMAGE=prom/prometheus:v3.13.2
GRAFANA_IMAGE=grafana/grafana:13.1.3
NODE_EXPORTER_IMAGE=quay.io/prometheus/node-exporter:v1.12.1

# Never store the Grafana password in this file.
# Export GRAFANA_ADMIN_PASSWORD in the deployment environment or provision
# the external Swarm secret 'grafana_admin_password' beforehand.
